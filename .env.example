# Sentinel AI Environment Configuration

# OpenAI API Key (optional - heuristics-only mode if omitted)
OPENAI_API_KEY=

# AI Model (gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
AI_MODEL=gpt-4o-mini

# Auto-Remove Confidence Threshold (75-99)
AUTO_REMOVE_THRESHOLD=92

# Daily OpenAI API Call Limit
DAILY_API_LIMIT=500

# Auto-Approve Trusted Users (true/false)
AUTO_APPROVE_TRUSTED_USERS=true

# Trusted User Threshold (0-100)
TRUSTED_USER_THRESHOLD=80

# Low Trust User Threshold (0-100)
LOW_TRUST_THRESHOLD=25

# Banned Keywords (comma-separated)
BANNED_KEYWORDS=

# Subreddit Rules (one per line)
SUBREDDIT_RULES=1. Be respectful\n2. No spam\n3. No self-promotion\n4. Stay on topic

# Removal Comment Template (use {reason} as placeholder)
REMOVAL_COMMENT=Your post/comment was removed by Sentinel AI: {reason}

# Enable Removal Comments (true/false)
ENABLE_REMOVAL_COMMENTS=true
